# REQUIRED: Google AI Studio API key.
# Get one at: https://aistudio.google.com/apikey
# NOTE (late 2026): Google's image models need billing enabled on the key's
# project (~$0.04/image) — the free tier no longer covers image generation
# for new accounts. The tryon-kolors app remains fully free.
# Copy this file to .env and paste the key below.
GEMINI_API_KEY=

# Optional: override the image model (default: gemini-3.1-flash-image)
# GEMINI_MODEL=gemini-3.1-flash-image
